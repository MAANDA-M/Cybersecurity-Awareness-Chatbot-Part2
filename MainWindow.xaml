<Window x:Class="CybersecurityChatbotWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CybersecurityChatbotWPF"
        mc:Ignorable="d"
        Title="Cybersecurity Chatbot" Height="650" Width="850" MinHeight="500" MinWidth="650"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Deep Ocean Blue Color Palette Configuration -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#334155"/>

        <SolidColorBrush x:Key="AccentSkyBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentCoralBrush" Color="#F43F5E"/>
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#7DD3FC"/>
        <SolidColorBrush x:Key="ButtonPressedBrush" Color="#0284C7"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="BorderMutedBrush" Color="#475569"/>

        <!-- Custom Styled TextBox Template -->
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="{StaticResource BorderMutedBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentSkyBrush}"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentSkyBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentCoralBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Styled Button Template with Animated States -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentSkyBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#7DD3FC" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#38BDF8" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource ButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Chat Display Layout Typography -->
        <Style x:Key="ChatDisplayStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="18"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Consolas, Cascadia Code, Segoe UI"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="LineHeight" Value="22"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="16*"/>
            <ColumnDefinition Width="32*"/>
            <ColumnDefinition Width="377*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Dynamic Header Panel Configuration -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="0,0,0,1.5" Padding="16,12" Grid.ColumnSpan="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Styled Visual Text-Logo Badge Replacement -->
                <Border Grid.Column="0" Background="#0F172A" BorderBrush="{StaticResource AccentSkyBrush}" BorderThickness="1.5" CornerRadius="6" Padding="10,6" Margin="5,0,15,0" VerticalAlignment="Center">
                    <TextBlock Text="CYBERSECURITY AWARENESS BOT" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentSkyBrush}"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                </StackPanel>
            </Grid>
        </Border>

        <!-- Unified Chat Monitor Frame -->
        <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" CornerRadius="12" Margin="20,20,20,10" Padding="4" Grid.ColumnSpan="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ChatDisplay" Style="{StaticResource ChatDisplayStyle}"/>
            </ScrollViewer>
        </Border>

        <!-- Base Message Processing Grid Layout -->
        <Grid Grid.Row="2" Margin="20,10,20,20" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="UserInputTextBox"
                     Grid.Column="0"
                     KeyDown="UserInputTextBox_KeyDown"
                     Height="46"
                     Margin="0,0,12,0"/>

            <Button x:Name="SendButton"
                    Grid.Column="1"
                    Content="Send Message"
                    Click="SendButton_Click"
                    Width="140"
                    Height="46"/>
        </Grid>
    </Grid>
</Window>